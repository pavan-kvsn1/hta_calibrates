# ===========================================
# HTA Calibration System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# Local Development: Start PostgreSQL with `npm run db:start`
DATABASE_URL=postgresql://hta_user:hta_dev_password@localhost:5432/hta_calibration

# Production: Use your PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# Authentication (NextAuth.js)
# ===========================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-generate-a-secure-one

# The URL where your app is hosted
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Application Settings
# ===========================================
# Environment: development | production | test
NODE_ENV=development

# ===========================================
# Email Configuration (Optional - for notifications)
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=noreply@htacalibration.com

# ===========================================
# PDF Generation (Optional)
# ===========================================
# COMPANY_NAME=HTA Calibration Services
# COMPANY_ADDRESS=123 Industrial Area, City
# COMPANY_LOGO_URL=/logo.png

# ===========================================
# Feature Flags (Optional)
# ===========================================
# ENABLE_CUSTOMER_PORTAL=true
# ENABLE_EMAIL_NOTIFICATIONS=false

# New Workflow Feature Flags
FEATURE_NEW_WORKFLOW=true    # Enable peer-based review workflow
FEATURE_CHAT=true            # Enable chat messaging system
FEATURE_TAT=true             # Enable TAT (Turn Around Time) tracking
FEATURE_UUC_IMAGES=true      # Enable UUC reading image uploads

# ===========================================
# Service Providers (Optional - defaults to local)
# ===========================================
# Queue provider: "database" (default) or "cloud-tasks"
# QUEUE_PROVIDER=database

# Storage provider: "local" (default) or "gcs"
# STORAGE_PROVIDER=local

# Email provider: "console" (default) or "sendgrid"
# EMAIL_PROVIDER=console

# Realtime provider: "polling" (default) or "firebase"
# REALTIME_PROVIDER=polling

# ===========================================
# GCP Configuration (Production)
# ===========================================
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION=us-central1
# GCS_BUCKET_NAME=your-bucket-name

# ===========================================
# SendGrid Configuration (if using sendgrid)
# ===========================================
# SENDGRID_API_KEY=SG.xxxxx

# ===========================================
# Firebase Configuration (if using firebase realtime)
# ===========================================
# NEXT_PUBLIC_FIREBASE_API_KEY=xxxxx
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://project.firebaseio.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=project-id
