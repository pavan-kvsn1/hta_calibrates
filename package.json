{
  "name": "hta-calibration",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:start": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:stop": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d postgres",
    "db:setup": "npx prisma generate && npx prisma db push",
    "db:test:start": "docker compose -f docker-compose.test.yml up -d",
    "db:test:stop": "docker compose -f docker-compose.test.yml down",
    "db:test:reset": "docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.test.yml up -d",
    "test": "vitest",
    "test:fast": "vitest run --testTimeout=5000 --reporter=dot tests/unit",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:workflows": "playwright test tests/e2e/workflows/",
    "test:e2e:journeys": "playwright test tests/e2e/journeys/",
    "test:a11y": "playwright test tests/e2e/accessibility/",
    "test:visual": "playwright test tests/e2e/visual/",
    "test:visual:update": "playwright test tests/e2e/evals/visual-regression.spec.ts --update-snapshots",
    "test:visual:docker": "docker compose -f docker-compose.playwright.yml up --build --abort-on-container-exit"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.11",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.47.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.562.0",
    "next": "^16.2.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-email": "^5.2.10",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/pino": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.1",
    "msw": "^2.12.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run test:fast --"
    ]
  },
  "overrides": {
    "hono": "^4.12.8",
    "@hono/node-server": "^1.19.11",
    "lodash": "^4.17.23"
  }
}
