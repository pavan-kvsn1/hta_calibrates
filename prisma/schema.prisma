generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ====================
// USERS
// ====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String?  // Nullable for Google-only users
  role            String   @default("ENGINEER") // ENGINEER, ADMIN
  isAdmin         Boolean  @default(false)      // Legacy: kept for migration
  adminType       String?  // "MASTER" | "WORKER" (null for non-admins)
  assignedAdminId String?  // Admin this engineer is assigned to
  assignedAdmin   User?    @relation("EngineerToAdmin", fields: [assignedAdminId], references: [id])
  engineers       User[]   @relation("EngineerToAdmin")
  signatureUrl  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Google OAuth fields
  googleId        String?  @unique  // Google OAuth subject ID
  authProvider    String   @default("PASSWORD") // PASSWORD or GOOGLE
  profileImageUrl String?  // From Google profile

  // Certificate relations
  createdCertificates  Certificate[] @relation("CertificateCreator")
  modifiedCertificates Certificate[] @relation("CertificateModifier")
  reviewedCertificates Certificate[] @relation("CertificateReviewer") // NEW: Certificates assigned for review

  // Event/Revision relations
  events               CertificateEvent[]    @relation("EventActor")
  submittedRevisions   CertificateRevision[] @relation("RevisionSubmitter")
  reviewedRevisions    CertificateRevision[] @relation("RevisionReviewer")

  // Feedback relations
  authoredFeedback     ReviewFeedback[]      @relation("FeedbackAuthor")
  resolvedFeedback     ReviewFeedback[]      @relation("FeedbackResolver")

  // Legacy (for gradual migration)
  signatures           Signature[]

  // Notifications
  notifications        Notification[]

  // Admin relations
  reviewedRegistrations   CustomerRegistration[] @relation("RegistrationReviewer")
  reviewedRequests        CustomerRequest[]      @relation("RequestReviewer")  // NEW: Customer requests reviewed by this admin
  managedCustomerAccounts CustomerAccount[]      @relation("AdminToCustomerAccount")
  modifiedInstruments     MasterInstrument[]     @relation("InstrumentModifier")

  // Chat relations
  chatMessages         ChatMessage[]
  uploadedUUCImages    UUCImage[]

  // Internal requests relations
  requestedInternalRequests  InternalRequest[] @relation("InternalRequestedBy")
  reviewedInternalRequests   InternalRequest[] @relation("InternalRequestReviewer")
}

model CustomerUser {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String
  passwordHash       String?  // Nullable until activated (POC workflow)
  companyName        String?  // Deprecated: use customerAccount.companyName (kept for migration)
  customerAccountId  String?  // Will become required after data migration
  isActive           Boolean  @default(false) // Changed: false until activated (POC workflow)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  // POC workflow fields
  isPoc              Boolean   @default(false)  // Is this user the Primary Point of Contact?
  activatedAt        DateTime?                   // When the user activated their account
  activationToken    String?   @unique          // Token for account activation
  activationExpiry   DateTime?                   // When the activation token expires

  // Relations
  customerAccount    CustomerAccount?  @relation("CustomerUsers", fields: [customerAccountId], references: [id])
  pocForAccount      CustomerAccount?  @relation("PrimaryPOC")  // Account where this user is POC
  signatures         Signature[]
  approvalTokens     ApprovalToken[]
  notifications      Notification[]
  events             CertificateEvent[]
  chatMessages       ChatMessage[]
  requestedRequests  CustomerRequest[] @relation("RequestedBy")  // Requests initiated by this user

  @@index([customerAccountId])
  @@index([activationToken])
}

// ====================
// CUSTOMER ACCOUNTS
// ====================

model CustomerAccount {
  id              String   @id @default(uuid())
  companyName     String   @unique
  address         String?
  contactEmail    String?
  contactPhone    String?
  assignedAdminId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Primary POC (Point of Contact)
  primaryPocId  String?  @unique
  primaryPoc    CustomerUser? @relation("PrimaryPOC", fields: [primaryPocId], references: [id])

  // Relations
  assignedAdmin User?                   @relation("AdminToCustomerAccount", fields: [assignedAdminId], references: [id])
  users         CustomerUser[]          @relation("CustomerUsers")
  registrations CustomerRegistration[]  // Keep for migration, will be removed later
  requests      CustomerRequest[]       // NEW: POC-initiated requests

  @@index([companyName])
  @@index([assignedAdminId])
}

// ====================
// GOOGLE OAUTH WHITELIST
// ====================

model AllowedGoogleEmail {
  id        String   @id @default(uuid())
  email     String   @unique  // Full email or domain pattern (e.g., "@htaipl.com")
  type      String   // EMAIL or DOMAIN
  role      String   @default("ENGINEER")  // Pre-assigned role
  hodId     String?  // Pre-assigned HoD (for engineers)
  name      String?  // Pre-filled display name
  isActive  Boolean  @default(true)
  createdBy String   // Admin who created this
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([type])
}

// ====================
// CUSTOMER REGISTRATION
// ====================

model CustomerRegistration {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String
  customerAccountId String
  status            String    @default("PENDING")  // PENDING, APPROVED, REJECTED
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())

  // Relations
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id])
  reviewedBy      User?           @relation("RegistrationReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([customerAccountId])
}

// ====================
// CUSTOMER REQUESTS (POC-initiated)
// ====================

// Request types
enum CustomerRequestType {
  USER_ADDITION  // POC requesting to add a new user
  POC_CHANGE     // POC requesting to transfer POC role to another user
}

// Request status
enum CustomerRequestStatus {
  PENDING   // Awaiting admin review
  APPROVED  // Request approved
  REJECTED  // Request denied
}

model CustomerRequest {
  id                String                @id @default(uuid())
  type              CustomerRequestType
  status            CustomerRequestStatus @default(PENDING)

  // Customer account this request belongs to
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])

  // Who initiated the request (nullable for admin-initiated additions - Decision #5)
  requestedById     String?
  requestedBy       CustomerUser? @relation("RequestedBy", fields: [requestedById], references: [id])

  // Request data (JSON for flexibility)
  // USER_ADDITION: { name: string, email: string }
  // POC_CHANGE: { newPocUserId: string, reason: string }
  data              String  // JSON stored as string for SQLite

  // Review info (who approved/rejected and when)
  reviewedById      String?
  reviewedBy        User?    @relation("RequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  rejectionReason   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([customerAccountId])
  @@index([status])
  @@index([type])
}

// ====================
// MASTER INSTRUMENTS (Versioned)
// ====================

model MasterInstrument {
  id                   String    @id @default(uuid())

  // Versioning
  instrumentId         String    // Groups all versions of same instrument
  version              Int       @default(1)
  isLatest             Boolean   @default(true)

  // Core fields
  legacyId             Int?      // Original JSON ID for migration tracking
  category             String    // Electro-Technical, Thermal, Mechanical, Dimensions, Others, Source
  description          String
  make                 String    // Serialized composite: "Ind: X / Sen: Y" for composite values
  model                String    // Serialized composite
  assetNumber          String    // Asset tracking number
  serialNumber         String    // Serialized composite
  usage                String?   // "For Lab" / "For Site"
  calibratedAtLocation String?   // Where it was calibrated
  reportNo             String?   // Calibration report number
  calibrationDueDate   DateTime? // When recalibration is due
  rangeData            String?   // JSON array: [{ parameter, minValue, maxValue, unit, uncertainty }, { referenceDoc }]
  remarks              String?   // Additional notes
  status               String?   // Explicit status override: UNDER_RECAL, SERVICE_PENDING (null = auto-compute from dates)
  isActive             Boolean   @default(true)

  // Audit fields (each version is immutable after creation)
  createdAt            DateTime  @default(now())
  createdById          String?   // User who created this version
  changeReason         String?   // "Import", "Manual Edit", "Recalibration Update", etc.

  // Migration tracking (only relevant for v1 records)
  importedFromJson     Boolean   @default(false)

  // Relations
  createdBy            User?     @relation("InstrumentModifier", fields: [createdById], references: [id])

  @@unique([instrumentId, version])
  @@index([instrumentId, isLatest])
  @@index([category])
  @@index([description])
  @@index([assetNumber])
  @@index([calibrationDueDate])
}

// ====================
// CERTIFICATES (Projection - Current State)
// ====================

model Certificate {
  id                String   @id @default(uuid())
  certificateNumber String   @unique
  status            String   @default("DRAFT") // DRAFT, PENDING_REVIEW, REVISION_REQUIRED, PENDING_CUSTOMER_APPROVAL, CUSTOMER_REVISION_REQUIRED, PENDING_ADMIN_AUTHORIZATION, AUTHORIZED, APPROVED, REJECTED
  currentRevision   Int      @default(1)

  // NEW: Reviewer assignment (peer review model)
  reviewerId        String?  // Engineer assigned to review this certificate
  reviewer          User?    @relation("CertificateReviewer", fields: [reviewerId], references: [id])

  // NEW: TAT (Turn Around Time) tracking
  customerApprovedAt DateTime?  // When customer approved - used for TAT calculation

  // Section 1: Summary
  calibratedAt       String?  // LAB, SITE
  srfNumber          String?
  srfDate            DateTime?
  dateOfCalibration  DateTime?
  calibrationTenure      Int      @default(12)
  dueDateAdjustment      Int      @default(0)
  calibrationDueDate     DateTime?
  dueDateNotApplicable   Boolean  @default(false)
  customerName           String?
  customerAddress    String?

  // Section 2: UUC Details
  uucDescription  String?
  uucMake         String?
  uucModel        String?
  uucSerialNumber String?
  uucInstrumentId String?
  uucLocationName String?
  uucMachineName  String?

  // Section 4: Environmental Conditions
  ambientTemperature String?
  relativeHumidity   String?

  // Section 6: Remarks
  calibrationStatus String?  // JSON array stored as string for SQLite
  stickerOldRemoved String?  // yes, no, na
  stickerNewAffixed String?  // yes, no, na
  statusNotes       String?  // Used for customer rejection feedback

  // Section 7: Conclusion Statements
  selectedConclusionStatements String? // JSON array stored as string for SQLite
  additionalConclusionStatement String? // Custom user-entered conclusion statement

  // Metadata
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  lastModifiedById String

  // Relations
  createdBy        User     @relation("CertificateCreator", fields: [createdById], references: [id])
  lastModifiedBy   User     @relation("CertificateModifier", fields: [lastModifiedById], references: [id])

  // Related data
  parameters        Parameter[]
  masterInstruments CertificateMasterInstrument[]

  // Event sourcing relations
  events    CertificateEvent[]
  revisions CertificateRevision[]
  feedbacks ReviewFeedback[]

  // Customer workflow
  signatures     Signature[]
  approvalTokens ApprovalToken[]

  // Signed PDF
  signedPdfPath  String?   // Path to stored signed PDF (relative to uploads dir)

  // OpenSign integration
  openSignDocuments OpenSignDocument[]

  // Signing evidence (Layers 1-4 defensibility)
  signingEvidence SigningEvidence[]

  // Notifications
  notifications  Notification[]

  // NEW: Chat system
  chatThreads    ChatThread[]

  // NEW: UUC reading images
  uucImages      UUCImage[]

  // Internal requests (section unlock requests)
  internalRequests InternalRequest[]

  @@index([status])
  @@index([createdById])
  @@index([reviewerId])  // NEW: Index for reviewer queries
}

// ====================
// CERTIFICATE EVENT (Event Log - Immutable)
// ====================

model CertificateEvent {
  id             String   @id @default(uuid())
  certificateId  String
  sequenceNumber Int      // Ordered sequence within certificate
  revision       Int      // Which revision this event belongs to

  eventType String // CERTIFICATE_CREATED, FIELD_UPDATED, BULK_FIELDS_UPDATED, PARAMETER_ADDED, etc.
  eventData String // JSON payload stored as string for SQLite

  userId     String?  // For staff events (engineer, HoD, admin)
  customerId String?  // For customer events
  userRole   String   // ENGINEER, HOD, ADMIN, CUSTOMER

  createdAt DateTime @default(now())

  // Relations
  certificate Certificate      @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  user        User?            @relation("EventActor", fields: [userId], references: [id])
  customer    CustomerUser?    @relation(fields: [customerId], references: [id])
  feedbacks   ReviewFeedback[]

  @@unique([certificateId, sequenceNumber])
  @@index([certificateId, createdAt])
  @@index([certificateId, revision])
}

// ====================
// CERTIFICATE REVISION (Snapshots at Workflow Transitions)
// ====================

model CertificateRevision {
  id             String @id @default(uuid())
  certificateId  String
  revisionNumber Int

  // Full snapshot of certificate data at this revision
  snapshotData String // JSON stored as string for SQLite

  // Workflow metadata
  status        String    // Status at this revision
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewOutcome String?   // APPROVED, REVISION_REQUIRED, REJECTED
  reviewNotes   String?

  // Event range for this revision
  fromEventSeq Int // First event sequence in this revision
  toEventSeq   Int // Last event sequence in this revision

  createdAt DateTime @default(now())

  // Relations
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  submittedBy User?       @relation("RevisionSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?       @relation("RevisionReviewer", fields: [reviewedById], references: [id])

  @@unique([certificateId, revisionNumber])
  @@index([certificateId, createdAt])
}

// ====================
// REVIEW FEEDBACK (HOD Comments)
// ====================

model ReviewFeedback {
  id             String  @id @default(uuid())
  certificateId  String
  revisionNumber Int
  eventId        String? // Optional: link to specific event

  feedbackType  String  // COMMENT, REVISION_REQUEST, APPROVAL_NOTE, REJECTION_REASON
  targetField   String? // Which field this feedback refers to (optional)
  targetSection String? // Which section this feedback refers to (optional)

  comment      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  certificate Certificate       @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  event       CertificateEvent? @relation(fields: [eventId], references: [id])
  user        User              @relation("FeedbackAuthor", fields: [userId], references: [id])
  resolvedBy  User?             @relation("FeedbackResolver", fields: [resolvedById], references: [id])

  @@index([certificateId, revisionNumber])
  @@index([certificateId, isResolved])
}

// ====================
// PARAMETERS & RESULTS
// ====================

model Parameter {
  id            String @id @default(uuid())
  certificateId String

  parameterName String
  parameterUnit String
  rangeMin      String?
  rangeMax      String?
  rangeUnit     String?
  operatingMin  String?
  operatingMax  String?
  operatingUnit String?
  leastCountValue String?
  leastCountUnit  String?
  accuracyValue   String?
  accuracyUnit    String?
  accuracyType    String  @default("ABSOLUTE") // PERCENT_READING, ABSOLUTE, PERCENT_SCALE
  errorFormula    String  @default("A-B")
  showAfterAdjustment Boolean @default(false)

  // Binning support
  requiresBinning Boolean @default(false)
  bins            String? // JSON array of bin objects

  // SOP reference and master instrument assignment
  sopReference       String?
  masterInstrumentId String?  // Reference to JSON master instrument ID (for parameter assignment)

  sortOrder Int @default(0)

  // Relations
  certificate Certificate         @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  results     CalibrationResult[]
  masterInstruments CertificateMasterInstrument[]

  @@index([certificateId])
}

model CalibrationResult {
  id          String @id @default(uuid())
  parameterId String

  pointNumber      Int
  standardReading  String?
  beforeAdjustment String?
  afterAdjustment  String?
  errorObserved    Float?
  isOutOfLimit     Boolean @default(false)

  // Relations
  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
}

// ====================
// MASTER INSTRUMENT LINKS (stores snapshot of instrument details at time of certificate creation)
// ====================

model CertificateMasterInstrument {
  id                 String  @id @default(uuid())
  certificateId      String
  parameterId        String?

  // Reference to JSON source (not a FK - instruments come from JSON file, not database)
  masterInstrumentId String   // ID from master-instruments.json

  // Snapshot of instrument details at time of certificate creation
  category           String?  // Electro-Technical, Thermal, Mechanical, etc.
  description        String?
  make               String?
  model              String?
  assetNo            String?
  serialNumber       String?
  calibratedAt       String?  // Where it was calibrated
  reportNo           String?  // Calibration report number
  calibrationDueDate String?  // Due date at time of certificate

  sopReference       String

  // Relations (no FK to MasterInstrument - data comes from JSON)
  certificate      Certificate       @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  parameter        Parameter?        @relation(fields: [parameterId], references: [id])

  @@index([certificateId])
}

// ====================
// SIGNATURES & APPROVAL
// ====================

model Signature {
  id            String       @id @default(uuid())
  certificateId String
  signerType    String       // ASSIGNEE, REVIEWER, CUSTOMER
  signerName    String
  signerEmail   String
  signatureData String
  signedAt      DateTime     @default(now())
  customerId    String?
  signerId      String?

  // Relations
  certificate Certificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  customer    CustomerUser? @relation(fields: [customerId], references: [id])
  signer      User?         @relation(fields: [signerId], references: [id])
}

model ApprovalToken {
  id            String       @id @default(uuid())
  certificateId String
  customerId    String
  token         String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  // Relations
  certificate Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  customer    CustomerUser @relation(fields: [customerId], references: [id])
}

// ====================
// AUDIT LOG (General system audit)
// ====================

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  actorType  String
  changes    String?  // JSON stored as string for SQLite
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ====================
// NOTIFICATIONS
// ====================

model Notification {
  id            String   @id @default(uuid())

  // Recipient (one of these will be set)
  userId        String?  // For staff (Engineer, HoD, Admin)
  customerId    String?  // For customers

  // Content
  type          String   // NotificationType: REVISION_REQUESTED, CERTIFICATE_APPROVED, SENT_TO_CUSTOMER, SUBMITTED_FOR_REVIEW, ENGINEER_RESPONDED, CUSTOMER_REVISION_REQUEST, CUSTOMER_APPROVED, CERTIFICATE_READY, HOD_REPLIED, CERTIFICATE_FINALIZED
  title         String
  message       String

  // Reference
  certificateId String?

  // Metadata
  data          String?  // JSON for additional context (e.g., sender name, cert number)

  // Status
  read          Boolean  @default(false)
  readAt        DateTime?

  // Timestamps
  createdAt     DateTime @default(now())

  // Relations
  user          User?         @relation(fields: [userId], references: [id])
  customer      CustomerUser? @relation(fields: [customerId], references: [id])
  certificate   Certificate?  @relation(fields: [certificateId], references: [id])

  @@index([userId, read])
  @@index([customerId, read])
  @@index([createdAt])
}

// ====================
// OPENSIGN INTEGRATION
// ====================

model OpenSignDocument {
  id                  String   @id @default(cuid())
  certificateId       String
  openSignDocumentId  String   @unique
  signerType          String   // REVIEWER, CUSTOMER
  signerEmail         String
  status              String   @default("PENDING") // PENDING, VIEWED, SIGNED, DECLINED, EXPIRED
  signingUrl          String?
  signedPdfUrl        String?
  auditTrailUrl       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  certificate         Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@index([status])
}

// ====================
// SIGNING EVIDENCE (Layers 1-4 Defensibility)
// ====================

model SigningEvidence {
  id              String   @id @default(cuid())
  certificateId   String
  signatureId     String?  // Links to Signature record (null for non-signing events)
  revision        Int      // Certificate revision number at time of signing

  // Chain integrity
  sequenceNumber  Int      // Monotonically increasing per certificate
  previousHash    String   // SHA-256 of previous record (or "GENESIS")
  recordHash      String   // SHA-256 of this record's evidence field

  // Evidence payload (immutable after creation)
  eventType       String   // ASSIGNEE_SIGNED, REVIEWER_SIGNED, CUSTOMER_SIGNED
  evidence        String   // JSON blob with all captured evidence

  createdAt       DateTime @default(now())

  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, sequenceNumber])
  @@index([certificateId])
  @@index([certificateId, revision])
}

// ====================
// CHAT SYSTEM
// ====================

model ChatThread {
  id            String   @id @default(uuid())
  certificateId String
  threadType    String   // "ASSIGNEE_REVIEWER" | "REVIEWER_CUSTOMER"
  createdAt     DateTime @default(now())

  // Relations
  certificate   Certificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@unique([certificateId, threadType])
  @@index([certificateId])
}

model ChatMessage {
  id           String   @id @default(uuid())
  threadId     String
  senderId     String?  // User ID (staff: engineer, admin)
  customerId   String?  // CustomerUser ID (for customer messages)
  senderType   String   // "ASSIGNEE" | "REVIEWER" | "CUSTOMER" | "ADMIN"
  content      String
  createdAt    DateTime @default(now())
  readAt       DateTime?

  // Relations
  thread       ChatThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User?            @relation(fields: [senderId], references: [id])
  customer     CustomerUser?    @relation(fields: [customerId], references: [id])
  attachments  ChatAttachment[]

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([customerId])
}

model ChatAttachment {
  id          String   @id @default(uuid())
  messageId   String
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String   // Path in storage (local or cloud)
  createdAt   DateTime @default(now())

  // Relations
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ====================
// UUC READING IMAGES
// ====================

model UUCImage {
  id            String   @id @default(uuid())
  certificateId String
  fileName      String
  fileSize      Int
  mimeType      String   // "image/jpeg" | "image/png" | "image/heic"
  storagePath   String   // Path in storage (local or cloud)
  caption       String?  // Optional description
  sortOrder     Int      @default(0)
  uploadedById  String
  createdAt     DateTime @default(now())

  // Relations
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])

  @@index([certificateId, sortOrder])
}

// ====================
// JOB QUEUE (Database-backed queue for local/MVP)
// ====================

model JobQueue {
  id           String    @id @default(uuid())
  type         String    // Job type: "chat:message:deliver", "notification:send", "email:send", etc.
  payload      String    // JSON payload
  status       String    @default("pending") // pending, processing, completed, failed, cancelled
  priority     Int       @default(0)         // Higher = processed first
  attempts     Int       @default(0)
  maxRetries   Int       @default(3)
  error        String?   // Error message if failed
  scheduledFor DateTime  @default(now())     // When to process (for delayed jobs)
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, scheduledFor, priority])
  @@index([type])
}

// ====================
// REALTIME EVENTS (Polling-based realtime for local/MVP)
// ====================

model RealtimeEvent {
  id          String   @id @default(uuid())
  userId      String?  // Recipient user ID (staff)
  customerId  String?  // Recipient customer ID
  channel     String   // Channel name: "user:{id}", "certificate:{id}", "thread:{id}"
  type        String   // Event type: "chat:message", "certificate:status", "notification"
  data        String   // JSON event data
  delivered   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, delivered, createdAt])
  @@index([customerId, delivered, createdAt])
  @@index([channel, createdAt])
}

// ====================
// REFRESH TOKENS (Secure Session Management)
// ====================

model RefreshToken {
  id            String   @id @default(uuid())
  token         String   @unique  // Hashed refresh token
  userId        String?  // For staff users
  customerId    String?  // For customer users
  userType      String   // "STAFF" | "CUSTOMER"
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  revokedAt     DateTime?
  revokedReason String?  // "LOGOUT", "PASSWORD_CHANGE", "ADMIN_REVOKE", "TOKEN_ROTATION"
  replacedById  String?  // New token ID if rotated

  // Device/session info for security
  userAgent     String?
  ipAddress     String?

  @@index([userId])
  @@index([customerId])
  @@index([token])
  @@index([expiresAt])
}

// ====================
// INTERNAL REQUESTS (Engineer-initiated)
// ====================

// Request types for internal staff
enum InternalRequestType {
  SECTION_UNLOCK  // Engineer requesting to unlock additional sections
  // Future: OTHER_TYPES
}

// Request status
enum InternalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model InternalRequest {
  id                String                @id @default(uuid())
  type              InternalRequestType
  status            InternalRequestStatus @default(PENDING)

  // Who made the request
  requestedById     String
  requestedBy       User                  @relation("InternalRequestedBy", fields: [requestedById], references: [id])

  // Related certificate (for SECTION_UNLOCK type)
  certificateId     String?
  certificate       Certificate?          @relation(fields: [certificateId], references: [id])

  // Request data (JSON)
  // SECTION_UNLOCK: { sections: string[], reason: string }
  data              String

  // Review info
  reviewedById      String?
  reviewedBy        User?                 @relation("InternalRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  adminNote         String?               // Optional note from admin

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([certificateId])
  @@index([status])
  @@index([type])
}
