// PostgreSQL Schema for Integration Testing
// This schema is used for production-parity testing in CI
// Run: npx prisma generate --schema=prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================
// USERS
// ====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String?
  role          String   @default("ENGINEER")
  isAdmin       Boolean  @default(false)
  assignedHodId String?
  assignedHod   User?    @relation("EngineerToHod", fields: [assignedHodId], references: [id])
  engineers     User[]   @relation("EngineerToHod")
  signatureUrl  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  googleId        String?  @unique
  authProvider    String   @default("PASSWORD")
  profileImageUrl String?

  createdCertificates  Certificate[] @relation("CertificateCreator")
  modifiedCertificates Certificate[] @relation("CertificateModifier")

  events               CertificateEvent[]    @relation("EventActor")
  submittedRevisions   CertificateRevision[] @relation("RevisionSubmitter")
  reviewedRevisions    CertificateRevision[] @relation("RevisionReviewer")

  authoredFeedback     ReviewFeedback[]      @relation("FeedbackAuthor")
  resolvedFeedback     ReviewFeedback[]      @relation("FeedbackResolver")

  signatures           Signature[]
  notifications        Notification[]

  reviewedRegistrations  CustomerRegistration[] @relation("RegistrationReviewer")
  managedCustomerAccounts CustomerAccount[]     @relation("HodToCustomerAccount")
  modifiedInstruments    MasterInstrument[]     @relation("InstrumentModifier")
}

model CustomerUser {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String
  passwordHash       String
  companyName        String?
  customerAccountId  String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  signatures      Signature[]
  approvalTokens  ApprovalToken[]
  notifications   Notification[]
  events          CertificateEvent[]

  @@index([customerAccountId])
}

// ====================
// CUSTOMER ACCOUNTS
// ====================

model CustomerAccount {
  id            String   @id @default(uuid())
  companyName   String   @unique
  address       String?
  contactEmail  String?
  contactPhone  String?
  assignedHodId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedHod   User?                   @relation("HodToCustomerAccount", fields: [assignedHodId], references: [id])
  users         CustomerUser[]
  registrations CustomerRegistration[]

  @@index([companyName])
  @@index([assignedHodId])
}

// ====================
// GOOGLE OAUTH WHITELIST
// ====================

model AllowedGoogleEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  type      String
  role      String   @default("ENGINEER")
  hodId     String?
  name      String?
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([type])
}

// ====================
// CUSTOMER REGISTRATION
// ====================

model CustomerRegistration {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String
  customerAccountId String
  status            String    @default("PENDING")
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id])
  reviewedBy      User?           @relation("RegistrationReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([customerAccountId])
}

// ====================
// MASTER INSTRUMENTS (Versioned)
// ====================

model MasterInstrument {
  id                   String    @id @default(uuid())

  instrumentId         String
  version              Int       @default(1)
  isLatest             Boolean   @default(true)

  legacyId             Int?
  category             String
  description          String
  make                 String
  model                String
  assetNumber          String
  serialNumber         String
  usage                String?
  calibratedAtLocation String?
  reportNo             String?
  calibrationDueDate   DateTime?
  rangeData            Json?     // PostgreSQL native JSON
  remarks              String?
  status               String?
  isActive             Boolean   @default(true)

  createdAt            DateTime  @default(now())
  createdById          String?
  changeReason         String?

  importedFromJson     Boolean   @default(false)

  createdBy            User?     @relation("InstrumentModifier", fields: [createdById], references: [id])

  @@unique([instrumentId, version])
  @@index([instrumentId, isLatest])
  @@index([category])
  @@index([description])
  @@index([assetNumber])
  @@index([calibrationDueDate])
}

// ====================
// CERTIFICATES
// ====================

model Certificate {
  id                String   @id @default(uuid())
  certificateNumber String   @unique
  status            String   @default("DRAFT")
  currentRevision   Int      @default(1)

  calibratedAt       String?
  srfNumber          String?
  srfDate            DateTime?
  dateOfCalibration  DateTime?
  calibrationTenure      Int      @default(12)
  dueDateAdjustment      Int      @default(0)
  calibrationDueDate     DateTime?
  dueDateNotApplicable   Boolean  @default(false)
  customerName           String?
  customerAddress    String?

  uucDescription  String?
  uucMake         String?
  uucModel        String?
  uucSerialNumber String?
  uucInstrumentId String?
  uucLocationName String?
  uucMachineName  String?

  ambientTemperature String?
  relativeHumidity   String?

  calibrationStatus Json?              // PostgreSQL native JSON
  stickerOldRemoved String?
  stickerNewAffixed String?
  statusNotes       String?

  selectedConclusionStatements Json?   // PostgreSQL native JSON
  additionalConclusionStatement String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  lastModifiedById String

  createdBy        User     @relation("CertificateCreator", fields: [createdById], references: [id])
  lastModifiedBy   User     @relation("CertificateModifier", fields: [lastModifiedById], references: [id])

  parameters        Parameter[]
  masterInstruments CertificateMasterInstrument[]

  events    CertificateEvent[]
  revisions CertificateRevision[]
  feedbacks ReviewFeedback[]

  signatures     Signature[]
  approvalTokens ApprovalToken[]

  signedPdfPath  String?

  openSignDocuments OpenSignDocument[]
  signingEvidence SigningEvidence[]
  notifications  Notification[]

  @@index([status])
  @@index([createdById])
}

// ====================
// CERTIFICATE EVENT
// ====================

model CertificateEvent {
  id             String   @id @default(uuid())
  certificateId  String
  sequenceNumber Int
  revision       Int

  eventType String
  eventData Json    // PostgreSQL native JSON

  userId     String?
  customerId String?
  userRole   String

  createdAt DateTime @default(now())

  certificate Certificate      @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  user        User?            @relation("EventActor", fields: [userId], references: [id])
  customer    CustomerUser?    @relation(fields: [customerId], references: [id])
  feedbacks   ReviewFeedback[]

  @@unique([certificateId, sequenceNumber])
  @@index([certificateId, createdAt])
  @@index([certificateId, revision])
}

// ====================
// CERTIFICATE REVISION
// ====================

model CertificateRevision {
  id             String @id @default(uuid())
  certificateId  String
  revisionNumber Int

  snapshotData Json    // PostgreSQL native JSON

  status        String
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewOutcome String?
  reviewNotes   String?

  fromEventSeq Int
  toEventSeq   Int

  createdAt DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  submittedBy User?       @relation("RevisionSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?       @relation("RevisionReviewer", fields: [reviewedById], references: [id])

  @@unique([certificateId, revisionNumber])
  @@index([certificateId, createdAt])
}

// ====================
// REVIEW FEEDBACK
// ====================

model ReviewFeedback {
  id             String  @id @default(uuid())
  certificateId  String
  revisionNumber Int
  eventId        String?

  feedbackType  String
  targetField   String?
  targetSection String?

  comment      String
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificate Certificate       @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  event       CertificateEvent? @relation(fields: [eventId], references: [id])
  user        User              @relation("FeedbackAuthor", fields: [userId], references: [id])
  resolvedBy  User?             @relation("FeedbackResolver", fields: [resolvedById], references: [id])

  @@index([certificateId, revisionNumber])
  @@index([certificateId, isResolved])
}

// ====================
// PARAMETERS & RESULTS
// ====================

model Parameter {
  id            String @id @default(uuid())
  certificateId String

  parameterName String
  parameterUnit String
  rangeMin      String?
  rangeMax      String?
  rangeUnit     String?
  operatingMin  String?
  operatingMax  String?
  operatingUnit String?
  leastCountValue String?
  leastCountUnit  String?
  accuracyValue   String?
  accuracyUnit    String?
  accuracyType    String  @default("ABSOLUTE")
  errorFormula    String  @default("A-B")
  showAfterAdjustment Boolean @default(false)

  requiresBinning Boolean @default(false)
  bins            Json?   // PostgreSQL native JSON

  sopReference       String?
  masterInstrumentId String?

  sortOrder Int @default(0)

  certificate Certificate         @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  results     CalibrationResult[]
  masterInstruments CertificateMasterInstrument[]

  @@index([certificateId])
}

model CalibrationResult {
  id          String @id @default(uuid())
  parameterId String

  pointNumber      Int
  standardReading  String?
  beforeAdjustment String?
  afterAdjustment  String?
  errorObserved    Float?
  isOutOfLimit     Boolean @default(false)

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
}

// ====================
// MASTER INSTRUMENT LINKS
// ====================

model CertificateMasterInstrument {
  id                 String  @id @default(uuid())
  certificateId      String
  parameterId        String?

  masterInstrumentId String

  category           String?
  description        String?
  make               String?
  model              String?
  assetNo            String?
  serialNumber       String?
  calibratedAt       String?
  reportNo           String?
  calibrationDueDate String?

  sopReference       String

  certificate      Certificate       @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  parameter        Parameter?        @relation(fields: [parameterId], references: [id])

  @@index([certificateId])
}

// ====================
// SIGNATURES & APPROVAL
// ====================

model Signature {
  id            String       @id @default(uuid())
  certificateId String
  signerType    String
  signerName    String
  signerEmail   String
  signatureData String
  signedAt      DateTime     @default(now())
  customerId    String?
  signerId      String?

  certificate Certificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  customer    CustomerUser? @relation(fields: [customerId], references: [id])
  signer      User?         @relation(fields: [signerId], references: [id])
}

model ApprovalToken {
  id            String       @id @default(uuid())
  certificateId String
  customerId    String
  token         String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  certificate Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  customer    CustomerUser @relation(fields: [customerId], references: [id])
}

// ====================
// AUDIT LOG
// ====================

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  actorType  String
  changes    Json?    // PostgreSQL native JSON
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ====================
// NOTIFICATIONS
// ====================

model Notification {
  id            String   @id @default(uuid())

  userId        String?
  customerId    String?

  type          String
  title         String
  message       String

  certificateId String?

  data          Json?    // PostgreSQL native JSON

  read          Boolean  @default(false)
  readAt        DateTime?

  createdAt     DateTime @default(now())

  user          User?         @relation(fields: [userId], references: [id])
  customer      CustomerUser? @relation(fields: [customerId], references: [id])
  certificate   Certificate?  @relation(fields: [certificateId], references: [id])

  @@index([userId, read])
  @@index([customerId, read])
  @@index([createdAt])
}

// ====================
// OPENSIGN INTEGRATION
// ====================

model OpenSignDocument {
  id                  String   @id @default(cuid())
  certificateId       String
  openSignDocumentId  String   @unique
  signerType          String
  signerEmail         String
  status              String   @default("PENDING")
  signingUrl          String?
  signedPdfUrl        String?
  auditTrailUrl       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  certificate         Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@index([status])
}

// ====================
// SIGNING EVIDENCE
// ====================

model SigningEvidence {
  id              String   @id @default(cuid())
  certificateId   String
  signatureId     String?
  revision        Int

  sequenceNumber  Int
  previousHash    String
  recordHash      String

  eventType       String
  evidence        Json     // PostgreSQL native JSON

  createdAt       DateTime @default(now())

  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, sequenceNumber])
  @@index([certificateId])
  @@index([certificateId, revision])
}
